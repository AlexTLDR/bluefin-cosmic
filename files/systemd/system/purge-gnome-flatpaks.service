[Unit]
Description=Purge leftover GNOME flatpaks (one-time, Bluefin pre-installs)
# Bluefin ships a set of GNOME apps as system flatpaks; they survive rebases
# because they live in /var. This unit removes them once, then leaves a marker
# file so it never runs again (delete the marker to re-run).
ConditionPathExists=!/var/lib/bluefin-cosmic/gnome-flatpaks-purged

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c 'for app in org.gnome.Snapshot org.gnome.SimpleScan org.gnome.Loupe org.gnome.Showtime org.gnome.Decibels org.gnome.Calendar org.gnome.Characters org.gnome.clocks org.gnome.Connections org.gnome.Contacts org.gnome.Maps org.gnome.Weather org.gnome.Logs org.gnome.Papers org.gnome.Extensions org.gnome.NautilusPreviewer org.gnome.FileRoller org.gnome.TextEditor org.gnome.baobab org.gnome.font-viewer; do flatpak uninstall --system --noninteractive -y "$app" >/dev/null 2>&1 || true; done; flatpak uninstall --system --noninteractive -y --unused >/dev/null 2>&1 || true; mkdir -p /var/lib/bluefin-cosmic && touch /var/lib/bluefin-cosmic/gnome-flatpaks-purged'

[Install]
WantedBy=multi-user.target
